{
  "name": "sba-replay-lite",
  "version": "1.1.14",
  "private": true,
  "type": "module",
  "description": "One referee, one phone: film a bout, mark the moments, look at them again.",
  "license": "GPL-3.0",
  "scripts": {
    "test": "npm run typecheck && vitest run",
    "typecheck": "tsc",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:e2e:headed": "VRL_HEADED=1 vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "serve": "node tools/serve.js",
    "build": "tsc -p tsconfig.build.json",
    "preview": "npm run build && node tools/make-preview.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "5.9.3",
    "vitest": "^3.0.5"
  }
}
